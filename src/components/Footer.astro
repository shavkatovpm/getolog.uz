---
import { type Lang, footer as ft, langPrefix } from "../i18n/translations";
import { landingPages } from "../data/landing";

interface Props { lang?: Lang }
const lang = Astro.props.lang || "uz" as Lang;
const prefix = langPrefix(lang);

const guidesLabel = { uz: "Qo'llanmalar", ru: "Руководства" };
---

<footer class="footer" role="contentinfo">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a href={prefix + "/"} class="footer__logo" aria-label="Getolog">
          <img src="/logo.png" alt="Getolog" class="logo-img" />
          <span>Getolog</span>
        </a>
        <p class="footer__tagline">{ft.tagline[lang]}</p>
      </div>
      <nav class="footer__links" aria-label={lang === "uz" ? "Footer navigatsiya" : "Навигация"}>
        <a href="https://t.me/getologbot" target="_blank" rel="noopener noreferrer">{ft.bot[lang]}</a>
        <a href="https://t.me/getolog_bot" target="_blank" rel="noopener noreferrer">{ft.help[lang]}</a>
        <a href={prefix + "/#faq"}>FAQ</a>
        <a href={prefix + "/blog"}>{ft.blog[lang]}</a>
        <a href={prefix + "/info"}>{ft.info[lang]}</a>
        <a href={prefix + "/offerta"}>{ft.offerta[lang]}</a>
      </nav>
    </div>
    <nav class="footer__guides" aria-label={guidesLabel[lang]}>
      <p class="footer__guides-title">{guidesLabel[lang]}</p>
      <ul>
        {landingPages.map((p) => (
          <li><a href={`${prefix}/${p.slug}`}>{p.keyword[lang]}</a></li>
        ))}
      </ul>
    </nav>
    <div class="footer__bottom">
      <p>{ft.copyright[lang]}</p>
    </div>
  </div>
</footer>

<style>
  .footer__guides {
    padding: 24px 0;
    border-top: 1px solid rgba(26, 29, 34, 0.06);
    margin-bottom: 8px;
  }

  .footer__guides-title {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--light-400);
    margin-bottom: 12px;
  }

  .footer__guides ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .footer__guides a {
    font-size: 0.85rem;
    color: var(--light-400);
    transition: color var(--transition);
  }

  .footer__guides a:hover {
    color: var(--accent);
  }

  .footer {
    border-top: 1px solid rgba(26, 29, 34, 0.08);
    padding: 48px 0 32px;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 40px;
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .logo-img {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: cover;
  }

  .footer__tagline {
    font-size: 0.9rem;
    color: var(--light-400);
  }

  .footer__links {
    display: flex;
    gap: 28px;
  }

  .footer__links a {
    font-size: 0.95rem;
    color: var(--light-400);
    transition: color var(--transition);
  }

  .footer__links a:hover {
    color: var(--light);
  }

  .footer__bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(26, 29, 34, 0.08);
  }

  .footer__bottom p {
    font-size: 0.85rem;
    color: var(--light-400);
  }

  @media (max-width: 768px) {
    .footer {
      padding: 36px 0 28px;
    }

    .footer__top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
      margin-bottom: 28px;
    }

    .footer__brand {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .footer__links {
      gap: 24px;
    }

    .footer__links a {
      font-size: 0.9rem;
    }

    .footer__bottom {
      text-align: center;
      padding-top: 20px;
    }

    .footer__bottom p {
      font-size: 0.8rem;
    }
  }
</style>
