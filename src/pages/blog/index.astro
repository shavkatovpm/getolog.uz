---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { type Lang, meta, langPrefix } from "../../i18n/translations";
import { articles } from "../../data/articles";
import { landingPages } from "../../data/landing";

interface Props { lang?: Lang }
const lang = Astro.props.lang || "uz" as Lang;
const prefix = langPrefix(lang);

const guidesTitle = { uz: "Mavzu bo'yicha qo'llanmalar", ru: "Руководства по темам" };
const blogUrl = `https://getolog.uz${prefix}/blog`;

const blogMeta = {
  title: { uz: "Maqolalar — Getolog", ru: "Статьи — Getolog" },
  desc: {
    uz: "Telegram kanalni monetizatsiya qilish, obuna boshqaruvi va bot sozlash haqida foydali maqolalar.",
    ru: "Полезные статьи о монетизации Telegram-каналов, управлении подписками и настройке ботов.",
  },
  heading: { uz: "Maqolalar", ru: "Статьи" },
  subtitle: {
    uz: "Telegram kanalni monetizatsiya qilish haqida foydali ma'lumotlar",
    ru: "Полезная информация о монетизации Telegram-каналов",
  },
  readMore: { uz: "Batafsil o'qish →", ru: "Читать далее →" },
};

const sorted = [...articles].sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title={blogMeta.title[lang]} description={blogMeta.desc[lang]} lang={lang}>
  <Navbar lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": blogUrl,
        "name": blogMeta.heading[lang],
        "description": blogMeta.desc[lang],
        "url": blogUrl,
        "inLanguage": lang,
        "isPartOf": { "@id": "https://getolog.uz/#website" },
        "publisher": { "@id": "https://getolog.uz/#organization" },
      },
      {
        "@type": "ItemList",
        "itemListOrder": "https://schema.org/ItemListOrderDescending",
        "numberOfItems": sorted.length + landingPages.length,
        "itemListElement": [
          ...sorted.map((a, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": a.title[lang],
            "url": `https://getolog.uz${prefix}/blog/${a.slug}`,
          })),
          ...landingPages.map((p, i) => ({
            "@type": "ListItem",
            "position": sorted.length + i + 1,
            "name": p.h1[lang],
            "url": `https://getolog.uz${prefix}/${p.slug}`,
          })),
        ],
      },
    ],
  })} />

  <section class="blog-hero">
    <div class="container">
      <h1 class="blog-hero__title">{blogMeta.heading[lang]}</h1>
      <p class="blog-hero__subtitle">{blogMeta.subtitle[lang]}</p>
    </div>
  </section>

  <section class="blog-guides">
    <div class="container">
      <h2 class="blog-guides__title">{guidesTitle[lang]}</h2>
      <div class="blog-guides__grid">
        {landingPages.map((p) => (
          <a href={`${prefix}/${p.slug}`} class="blog-guides__item">
            <span class="blog-guides__cat">{p.category[lang]}</span>
            <span class="blog-guides__name">{p.h1[lang]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="blog-list-section">
    <div class="container">
      <div class="blog-grid">
        {sorted.map((article) => {
          const dateObj = new Date(article.date);
          const dateStr = dateObj.toLocaleDateString(lang === "uz" ? "uz-UZ" : "ru-RU", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
          return (
            <a href={`${prefix}/blog/${article.slug}`} class="blog-card">
              <div class="blog-card__meta">
                <span class="blog-card__category">{article.category[lang]}</span>
                <span class="blog-card__date">{dateStr}</span>
              </div>
              <h2 class="blog-card__title">{article.title[lang]}</h2>
              <p class="blog-card__desc">{article.description[lang]}</p>
              <span class="blog-card__link">{blogMeta.readMore[lang]}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  .blog-guides {
    padding-bottom: 48px;
  }

  .blog-guides__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 20px;
  }

  .blog-guides__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .blog-guides__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    background: var(--dark-800);
    border: 1px solid rgba(26, 29, 34, 0.06);
    border-radius: var(--radius);
    transition: border-color var(--transition), transform var(--transition);
  }

  .blog-guides__item:hover {
    border-color: rgba(91, 107, 122, 0.28);
    transform: translateY(-2px);
  }

  .blog-guides__cat {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  .blog-guides__name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--light);
    line-height: 1.45;
  }

  .blog-hero {
    padding: 140px 0 60px;
    text-align: center;
  }

  .blog-hero__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.5px;
  }

  .blog-hero__subtitle {
    font-size: 1.1rem;
    color: var(--light-400);
    max-width: 520px;
    margin: 0 auto;
  }

  .blog-list-section {
    padding-bottom: 80px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 840px;
    margin: 0 auto;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--dark-800);
    border: 1px solid rgba(26, 29, 34, 0.06);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    transition: all var(--transition);
    text-decoration: none;
  }

  .blog-card:hover {
    border-color: rgba(91, 107, 122, 0.25);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(20, 25, 35, 0.08);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .blog-card__category {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(91, 107, 122, 0.1);
    padding: 4px 12px;
    border-radius: 100px;
    letter-spacing: 0.3px;
  }

  .blog-card__date {
    font-size: 0.8rem;
    color: var(--light-400);
  }

  .blog-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .blog-card__desc {
    font-size: 0.9rem;
    color: var(--light-400);
    line-height: 1.6;
    margin-bottom: 20px;
    flex: 1;
  }

  .blog-card__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    transition: all var(--transition);
  }

  .blog-card:hover .blog-card__link {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 768px) {
    .blog-hero {
      padding: 110px 0 40px;
    }

    .blog-hero__title {
      font-size: 1.75rem;
    }

    .blog-hero__subtitle {
      font-size: 0.95rem;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .blog-card {
      padding: 24px 20px;
    }

    .blog-card:hover {
      transform: none;
    }

    .blog-list-section {
      padding-bottom: 40px;
    }
  }
</style>
