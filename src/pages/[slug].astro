---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { type Lang, langPrefix } from "../i18n/translations";
import { landingPages, getLandingPage } from "../data/landing";
import { articles } from "../data/articles";

interface Props { lang?: Lang }
const lang = Astro.props.lang || ("uz" as Lang);
const prefix = langPrefix(lang);

const { slug } = Astro.params;
const page = getLandingPage(slug as string);

if (!page) {
  return Astro.redirect(prefix + "/");
}

const t = {
  answerLabel: { uz: "Qisqa javob", ru: "Короткий ответ" },
  toc: { uz: "Sahifa mundarijasi", ru: "Содержание страницы" },
  updated: { uz: "Yangilangan", ru: "Обновлено" },
  readTime: { uz: "O'qish vaqti", ru: "Время чтения" },
  faqTitle: { uz: "Ko'p so'raladigan savollar", ru: "Часто задаваемые вопросы" },
  compareManual: { uz: "Qo'lda", ru: "Вручную" },
  compareGetolog: { uz: "Getolog bilan", ru: "С Getolog" },
  ctaTitle: { uz: "Kanalingizni bugun avtomatlashtiring", ru: "Автоматизируйте канал уже сегодня" },
  ctaText: {
    uz: "Sozlash 2 daqiqa. Bepul tarifda 20 tagacha obunachi bilan sinab ko'rishingiz mumkin.",
    ru: "Настройка — 2 минуты. На бесплатном тарифе можно попробовать с 20 подписчиками.",
  },
  ctaBtn: { uz: "Telegram'da boshlash", ru: "Начать в Telegram" },
  ctaHelp: { uz: "Savolingiz bormi? Support:", ru: "Есть вопрос? Поддержка:" },
  relatedTitle: { uz: "Shuni ham o'qing", ru: "Читайте также" },
  home: { uz: "Getolog", ru: "Getolog" },
  author: { uz: "Getolog jamoasi", ru: "Команда Getolog" },
};

const pageUrl = `https://getolog.uz${prefix}/${page.slug}`;
const homeUrl = lang === "uz" ? "https://getolog.uz" : "https://getolog.uz/ru";

const updatedStr = new Date(page.updated).toLocaleDateString(
  lang === "uz" ? "uz-UZ" : "ru-RU",
  { year: "numeric", month: "long", day: "numeric" },
);

const relatedLanding = page.related
  .map((s) => landingPages.find((p) => p.slug === s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const relatedBlog = (page.relatedArticles || [])
  .map((s) => articles.find((a) => a.slug === s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": pageUrl + "#article",
      "headline": page.h1[lang],
      "description": page.description[lang],
      "abstract": page.answer[lang],
      "datePublished": page.published,
      "dateModified": page.updated,
      "author": {
        "@type": "Organization",
        "name": "Getolog",
        "url": "https://getolog.uz",
      },
      "publisher": { "@id": "https://getolog.uz/#organization" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
      "inLanguage": lang,
      "about": { "@id": "https://getolog.uz/#software" },
      "articleSection": page.category[lang],
      "keywords": page.keyword[lang],
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Getolog", "item": homeUrl },
        { "@type": "ListItem", "position": 2, "name": page.h1[lang], "item": pageUrl },
      ],
    },
    ...(page.faq.length > 0
      ? [{
          "@type": "FAQPage",
          "@id": pageUrl + "#faq",
          "mainEntity": page.faq.map((f) => ({
            "@type": "Question",
            "name": f.q[lang],
            "acceptedAnswer": { "@type": "Answer", "text": f.a[lang] },
          })),
        }]
      : []),
  ],
};

export function getStaticPaths() {
  return landingPages.map((p) => ({ params: { slug: p.slug } }));
}
---

<Layout
  title={`${page.title[lang]} — Getolog`}
  description={page.description[lang]}
  lang={lang}
  ogType="article"
>
  <Navbar lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <article class="lp">
    <div class="container">
      <nav class="lp__crumb" aria-label="Breadcrumb">
        <a href={homeUrl}>{t.home[lang]}</a>
        <span>/</span>
        <span class="current">{page.h1[lang]}</span>
      </nav>

      <header class="lp__header">
        <div class="lp__meta">
          <span class="lp__category">{page.category[lang]}</span>
          <span>{t.updated[lang]}: {updatedStr}</span>
          <span>{t.readTime[lang]}: {page.readTime[lang]}</span>
        </div>
        <h1 class="lp__title">{page.h1[lang]}</h1>
        <p class="lp__desc">{page.description[lang]}</p>
      </header>

      <!-- AEO: to'g'ridan-to'g'ri javob bloki -->
      <div class="lp__answer">
        <span class="lp__answer-label">{t.answerLabel[lang]}</span>
        <p>{page.answer[lang]}</p>
      </div>

      <nav class="lp__toc" aria-label={t.toc[lang]}>
        <p class="lp__toc-title">{t.toc[lang]}</p>
        <ol>
          {page.sections.map((s, i) => (
            <li><a href={`#sec-${i + 1}`}>{s.h2[lang]}</a></li>
          ))}
          {page.compare && <li><a href="#compare">{page.compare.title[lang]}</a></li>}
          {page.faq.length > 0 && <li><a href="#faq">{t.faqTitle[lang]}</a></li>}
        </ol>
      </nav>

      <div class="lp__body">
        {page.sections.map((s, i) => (
          <section class="lp__section">
            <h2 id={`sec-${i + 1}`}>{s.h2[lang]}</h2>
            <div set:html={s.html[lang]} />
          </section>
        ))}
      </div>

      {page.compare && (
        <section class="lp__compare">
          <h2 id="compare">{page.compare.title[lang]}</h2>
          <div class="lp__table-wrap">
            <table>
              <thead>
                <tr>
                  <th></th>
                  <th>{t.compareManual[lang]}</th>
                  <th>{t.compareGetolog[lang]}</th>
                </tr>
              </thead>
              <tbody>
                {page.compare.rows.map((row) => (
                  <tr>
                    <td class="lp__row-label">{row.label[lang]}</td>
                    <td>{row.manual[lang]}</td>
                    <td class="lp__row-good">{row.getolog[lang]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {page.faq.length > 0 && (
        <section class="lp__faq">
          <h2 id="faq">{t.faqTitle[lang]}</h2>
          <div class="lp__faq-list">
            {page.faq.map((f) => (
              <details class="lp__faq-item">
                <summary>{f.q[lang]}</summary>
                <p>{f.a[lang]}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="lp__cta">
        <h2>{t.ctaTitle[lang]}</h2>
        <p>{t.ctaText[lang]}</p>
        <a
          href="https://t.me/getologbot"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--primary btn--lg"
        >
          {t.ctaBtn[lang]}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <p class="lp__cta-help">
          {t.ctaHelp[lang]}{" "}
          <a href="https://t.me/getolog_bot" target="_blank" rel="noopener noreferrer">@getolog_bot</a>
        </p>
      </section>

      {(relatedLanding.length > 0 || relatedBlog.length > 0) && (
        <section class="lp__related">
          <h2>{t.relatedTitle[lang]}</h2>
          <ul>
            {relatedLanding.map((p) => (
              <li><a href={`${prefix}/${p.slug}`}>{p.h1[lang]}</a></li>
            ))}
            {relatedBlog.map((a) => (
              <li><a href={`${prefix}/blog/${a.slug}`}>{a.title[lang]}</a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>

  <Footer lang={lang} />
</Layout>

<style>
  .lp {
    padding-top: 120px;
    padding-bottom: 80px;
  }

  .lp__crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .lp__crumb a {
    color: var(--accent);
    font-weight: 500;
  }

  .lp__crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lp__crumb span {
    color: var(--light-400);
    opacity: 0.5;
  }

  .lp__crumb .current {
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 340px;
  }

  .lp__header,
  .lp__answer,
  .lp__toc,
  .lp__body,
  .lp__compare,
  .lp__faq,
  .lp__cta,
  .lp__related {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .lp__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .lp__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--light-400);
  }

  .lp__category {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(91, 107, 122, 0.1);
    padding: 4px 12px;
    border-radius: 100px;
  }

  .lp__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.5px;
    line-height: 1.25;
  }

  .lp__desc {
    font-size: 1.05rem;
    color: var(--light-400);
    line-height: 1.6;
  }

  /* AEO javob bloki */
  .lp__answer {
    background: var(--dark-800);
    border: 1px solid rgba(91, 107, 122, 0.18);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 22px 26px;
    margin-bottom: 36px;
  }

  .lp__answer-label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .lp__answer p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--light);
    margin: 0;
  }

  /* Mundarija */
  .lp__toc {
    border: 1px solid rgba(26, 29, 34, 0.08);
    border-radius: var(--radius);
    padding: 20px 26px;
    margin-bottom: 44px;
  }

  .lp__toc-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--light-400);
    margin-bottom: 12px;
  }

  .lp__toc ol {
    padding-left: 18px;
    margin: 0;
  }

  .lp__toc li {
    font-size: 0.92rem;
    margin-bottom: 6px;
    color: var(--light-400);
  }

  .lp__toc a {
    color: var(--light-200);
  }

  .lp__toc a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Matn */
  .lp__section {
    margin-bottom: 40px;
  }

  .lp__body :global(h2),
  .lp__compare h2,
  .lp__faq h2,
  .lp__cta h2,
  .lp__related h2 {
    font-size: 1.45rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--white);
    scroll-margin-top: 90px;
  }

  .lp__body :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 26px;
    margin-bottom: 10px;
    color: var(--light);
  }

  .lp__body :global(p) {
    font-size: 0.97rem;
    color: var(--light-400);
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .lp__body :global(ul),
  .lp__body :global(ol) {
    padding-left: 22px;
    margin-bottom: 16px;
  }

  .lp__body :global(li) {
    font-size: 0.97rem;
    color: var(--light-400);
    line-height: 1.75;
    margin-bottom: 10px;
  }

  .lp__body :global(strong) {
    color: var(--light);
  }

  .lp__body :global(a) {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lp__body :global(code) {
    background: rgba(91, 107, 122, 0.1);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--accent);
  }

  .lp__body :global(table),
  .lp__table-wrap table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    font-size: 0.92rem;
  }

  .lp__body :global(th),
  .lp__body :global(td),
  .lp__table-wrap th,
  .lp__table-wrap td {
    text-align: left;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(26, 29, 34, 0.08);
    color: var(--light-400);
    vertical-align: top;
  }

  .lp__body :global(th),
  .lp__table-wrap th {
    font-weight: 600;
    color: var(--light);
    background: var(--dark-800);
  }

  .lp__body :global(table) {
    display: block;
    overflow-x: auto;
  }

  /* Taqqoslash */
  .lp__compare {
    margin-bottom: 44px;
  }

  .lp__table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(26, 29, 34, 0.08);
    border-radius: var(--radius);
  }

  .lp__table-wrap table {
    margin-bottom: 0;
    min-width: 520px;
  }

  .lp__row-label {
    font-weight: 600;
    color: var(--light);
    white-space: nowrap;
  }

  .lp__row-good {
    color: var(--light);
  }

  /* FAQ */
  .lp__faq {
    margin-bottom: 44px;
  }

  .lp__faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lp__faq-item {
    background: var(--dark-800);
    border: 1px solid rgba(26, 29, 34, 0.06);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .lp__faq-item[open] {
    border-color: rgba(91, 107, 122, 0.2);
  }

  .lp__faq-item summary {
    padding: 18px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--light);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .lp__faq-item summary::-webkit-details-marker {
    display: none;
  }

  .lp__faq-item summary::after {
    content: '+';
    font-size: 1.3rem;
    color: var(--accent);
    flex-shrink: 0;
  }

  .lp__faq-item[open] summary::after {
    content: '\2212';
  }

  .lp__faq-item p {
    padding: 0 24px 18px;
    font-size: 0.92rem;
    color: var(--light-400);
    line-height: 1.75;
    margin: 0;
  }

  /* CTA */
  .lp__cta {
    text-align: center;
    padding: 36px 24px;
    background: var(--dark-800);
    border-radius: var(--radius-lg);
    margin-bottom: 40px;
  }

  .lp__cta p {
    color: var(--light-400);
    margin-bottom: 22px;
    font-size: 0.97rem;
  }

  .lp__cta-help {
    margin-top: 18px;
    margin-bottom: 0 !important;
    font-size: 0.88rem;
  }

  .lp__cta-help a {
    color: var(--accent);
    font-weight: 500;
  }

  /* Related */
  .lp__related ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lp__related a {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .lp__related a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .lp {
      padding-top: 100px;
      padding-bottom: 60px;
    }

    .lp__title {
      font-size: 1.5rem;
    }

    .lp__answer {
      padding: 18px 20px;
    }

    .lp__body :global(h2),
    .lp__compare h2,
    .lp__faq h2,
    .lp__cta h2,
    .lp__related h2 {
      font-size: 1.25rem;
    }

    .lp__crumb .current {
      max-width: 220px;
    }
  }
</style>
