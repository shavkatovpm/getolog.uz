---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { type Lang, notFound, langPrefix } from "../i18n/translations";

interface Props { lang?: Lang }
const lang = Astro.props.lang || ("uz" as Lang);
const prefix = langPrefix(lang);
---

<Layout
  title={notFound.title[lang]}
  description={notFound.desc[lang]}
  lang={lang}
  image={lang === "uz" ? "/og/home.png" : "/og/ru.png"}
>
  <Navbar lang={lang} />

  <section class="error-page">
    <div class="container error-page__inner">
      <span class="error-page__code">404</span>
      <h1 class="error-page__title" data-uz={notFound.heading.uz} data-ru={notFound.heading.ru}>{notFound.heading[lang]}</h1>
      <p class="error-page__desc" data-uz={notFound.text.uz} data-ru={notFound.text.ru}>{notFound.text[lang]}</p>
      <a href={prefix + "/"} class="btn btn--primary btn--lg error-page__btn" data-uz={notFound.btn.uz} data-ru={notFound.btn.ru}>{notFound.btn[lang]}</a>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 0 80px;
  }

  .error-page__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .error-page__code {
    font-size: clamp(6rem, 15vw, 10rem);
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
    opacity: 0.15;
  }

  .error-page__title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    margin-top: -20px;
  }

  .error-page__desc {
    font-size: 1.05rem;
    color: var(--light-400);
    max-width: 400px;
    line-height: 1.6;
    margin-bottom: 16px;
  }
</style>

<script>
  if (window.location.pathname.startsWith("/ru")) {
    document.documentElement.lang = "ru";
    document.querySelectorAll("[data-ru]").forEach((el) => {
      const ru = el.getAttribute("data-ru")!;
      if (el.tagName === "A") {
        el.textContent = ru;
        (el as HTMLAnchorElement).href = "/ru/";
      } else {
        el.textContent = ru;
      }
    });
  }
</script>
